# Binários e saída de build (inclui bin/pipeline-claude, instalado por make tools)
bin/
# Binário que `go build ./...` (sensor build) grava na raiz
/biblioteca-bairro
dist/
*.exe
*.dll
*.so
*.dylib

# Artefatos de teste e cobertura
*.out
*.test
coverage.html

# Segredos e variáveis de ambiente
.env
.env.*
!.env.example
secrets/
*.pem
*.key
credentials
# Cópia local do environment do Postman, com o token preenchido
postman/*.local.postman_environment.json

# Configuração pessoal do Claude Code (não versionada)
.claude/settings.local.json

# Sistema operacional e temporários
.DS_Store
Thumbs.db
*.tmp

# Log das decisões do hook (hook_log), local de cada máquina
/.pipeline-claude/
