              "raw": "{\n  \"usuario_id\": {{usuario_id}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/livros/{{livro_id}}/emprestimo",
              "host": ["{{base_url}}"],
              "path": ["livros", "{{livro_id}}", "emprestimo"]
            },
            "description": "Corpo `{\"usuario_id\": número}`; o livro vem do path. 201 com o empréstimo (o script grava `emprestimo_id`). Erros: 400 id_invalido, corpo_invalido; 404 livro_nao_encontrado; 409 livro_ja_emprestado; 413 corpo_muito_grande; 422 usuario_id_invalido, usuario_nao_encontrado."
          },
          "response": []
        },
        {
          "name": "Consultar empréstimo aberto do livro",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/livros/{{livro_id}}/emprestimo",
              "host": ["{{base_url}}"],
              "path": ["livros", "{{livro_id}}", "emprestimo"]
            },
            "description": "200 com o empréstimo aberto do livro e a multa calculada agora. Erros: 400 id_invalido; 404 emprestimo_aberto_nao_encontrado."
          },
          "response": []
